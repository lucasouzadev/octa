{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"outputDirectory": "build",
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/200.html"
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Content-Security-Policy",
					"value": "frame-ancestors 'none'"
				},
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				}
			]
		}
	]
}
