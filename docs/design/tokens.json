{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "bg": { "light": { "$value": "#FFFFFF" }, "dark": { "$value": "#000000" } },
    "surface": { "light": { "$value": "#EDEDED" }, "lightButton": { "$value": "#E2E2E2" }, "dark": { "$value": "#2E2E2E" }, "darkRaised": { "$value": "#3D3D3D" } },
    "paper": { "base": { "$value": "#F3F1EC" }, "edge1": { "$value": "#D8D5CE" }, "edge2": { "$value": "#BCB9B2" }, "edge3": { "$value": "#A19E98" } },
    "text": { "light": { "$value": "#0A0A0A" }, "dark": { "$value": "#FFFFFF" } },
    "muted": { "onLight": { "$value": "#5C5C5C" }, "onDark": { "$value": "#A3A3A3" }, "hintOnDark": { "$value": "#8A8A8A" } },
    "action": { "create": { "$value": "#1A3CFF" }, "alert": { "$value": "#FF6A2B" }, "success": { "$value": "#00804A" } },
    "status": { "dead": { "$value": "#C2410C" } }
  },
  "font": {
    "display": { "$value": "Newsreader, Georgia, serif" },
    "ui": { "$value": "Inter, system-ui, sans-serif" }
  },
  "size": {
    "display": { "$value": "clamp(46px, 4vw + 30px, 72px)" },
    "title": { "$value": "clamp(30px, 1.5vw + 24px, 40px)" },
    "h2": { "$value": "clamp(24px, 1vw + 20px, 30px)" },
    "body": { "$value": "17px" },
    "meta": { "$value": "13px" },
    "label": { "$value": "12px" }
  },
  "space": { "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" }, "5": { "$value": "20px" }, "6": { "$value": "24px" }, "7": { "$value": "28px" }, "8": { "$value": "36px" }, "9": { "$value": "48px" }, "10": { "$value": "64px" }, "11": { "$value": "96px" } },
  "radius": { "thumb": { "$value": "12px" }, "paper": { "$value": "10px" }, "video": { "$value": "20px" }, "card": { "$value": "30px" }, "pill": { "$value": "999px" } },
  "layout": { "contentMax": { "$value": "720px" }, "touchMin": { "$value": "44px" } },
  "motion": {
    "viewTransition": { "$value": "380ms cubic-bezier(.2,.8,.2,1)" },
    "colorFade": { "$value": "320ms ease-out" },
    "press": { "$value": "120ms ease-out" }
  },
  "three": { "fanTiltDeg": { "$value": 16 }, "stackRotateXDeg": { "$value": 14 }, "maxDpr": { "$value": 2 } }
}
